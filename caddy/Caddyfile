{
	admin off

	servers {
		trusted_proxies static private_ranges
	}
}

:{$CADDY_PORT:80} {
	log {
		output {$CADDY_LOG_OUTPUT:discard}
		format json
	}

	# Only the stats queries are public; traffic-analytics writes events to
	# traffic-stats inside the network.
	handle /.ghost/stats/v0/pipes/* {
		uri strip_prefix /.ghost/stats
		reverse_proxy {$TRAFFIC_STATS_UPSTREAM:traffic-stats}:3000
	}

	handle /.ghost/stats/* {
		respond 404
	}

	handle_path /.ghost/analytics/* {
		reverse_proxy {$TRAFFIC_ANALYTICS_UPSTREAM:traffic-analytics}:3000
	}

	handle {
		reverse_proxy {$GHOST_UPSTREAM:ghost}:2368
	}
}
