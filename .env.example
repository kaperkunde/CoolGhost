# Values for running the stack locally with plain Docker Compose:
#   cp .env.example .env
#   docker compose -f docker-compose.yaml -f docker-compose.local.yaml up -d
# On Coolify, Coolify generates the SERVICE_* values itself; see README.md.

# Public URL of the site. Locally, Caddy is published on CADDY_PORT.
SERVICE_URL_CADDY=http://localhost:3000
CADDY_PORT=3000

# MySQL credentials. Read by MySQL only when its volume is first created.
SERVICE_USER_MYSQL=local
SERVICE_PASSWORD_MYSQL=local
SERVICE_PASSWORD_MYSQLROOT=localroot

# Password of ClickHouse's `default` user, shared with traffic-stats.
SERVICE_PASSWORD_CLICKHOUSE=local

# Caddy's access log: discard (the default), stdout or stderr.
CADDY_LOG_OUTPUT=stdout

# Mail. Ghost starts without it, but staff invites, password resets and
# member sign-in links need working SMTP.
# MAIL_FROM=Ghost <noreply@blog.example.com>
# MAIL_OPTIONS_HOST=smtp.eu.mailgun.org
# MAIL_OPTIONS_PORT=465
# MAIL_OPTIONS_SECURE=true
# MAIL_OPTIONS_SERVICE=Mailgun
# MAIL_OPTIONS_AUTH_USER=
# MAIL_OPTIONS_AUTH_PASS=

# Optional overrides (defaults in docker-compose.yaml):
# GHOST_DATABASE=ghost
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# LABS_PUBLIC_API=false
# GHOST_VERSION=6.72.0-alpine
# MYSQL_VERSION=8
# TRAFFIC_ANALYTICS_VERSION=1.0.497
